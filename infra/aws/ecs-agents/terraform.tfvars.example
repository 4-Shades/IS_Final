aws_region            = "us-east-1"
name_prefix            = "travel"
vpc_id                 = "vpc-xxxxxxxx"
task_subnet_ids        = ["subnet-xxxxxxxx", "subnet-yyyyyyyy"]
public_subnet_ids      = ["subnet-public-xxxxxxxx", "subnet-public-yyyyyyyy"]
ecs_security_group_id  = "sg-xxxxxxxx"
alb_security_group_id  = "sg-zzzzzzzz"
execution_role_arn     = "arn:aws:iam::123456789012:role/ecsTaskExecutionRole"
task_role_arn          = "arn:aws:iam::123456789012:role/travelAgentTaskRole"
image_tag              = "2026-09-25-001"
flight_service_url     = "https://your-railway-flight-domain"
llm_provider           = "openai"
openai_model           = "gpt-4o-mini"
openai_api_key_parameter_arn = "arn:aws:ssm:us-east-1:123456789012:parameter/travel/openai-api-key"
# Only used when llm_provider = "ollama":
# ollama_base_url        = "https://your-ollama-domain"
desired_count          = 1
use_fargate_spot       = true
schedule_enabled       = true
schedule_timezone      = "Asia/Manila"
schedule_start_cron    = "cron(0 8 * * ? *)"
schedule_stop_cron     = "cron(0 22 * * ? *)"
