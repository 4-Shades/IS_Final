# Core LLM settings
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=90

# Optional fallback for temporary OpenAI comparison only
# Set LLM_PROVIDER=openai to use this provider instead.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_API_KEY=xxxxxxxxxx

# Open travel-data providers
OPEN_TRAVEL_DATA_ENABLED=false
WEATHER_PROVIDER_ENABLED=false
PLACES_PROVIDER_ENABLED=false
GROUND_TRANSPORT_ENABLED=false

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# Service URLs
HOST_SERVICE_URL=http://localhost:8000
FLIGHT_SERVICE_URL=http://localhost:8001
STAY_SERVICE_URL=http://localhost:8002
ACTIVITIES_SERVICE_URL=http://localhost:8003
DOWNSTREAM_TIMEOUT_SECONDS=30

# Local database / dev convenience
POSTGRES_PASSWORD=replace-with-a-local-development-password
