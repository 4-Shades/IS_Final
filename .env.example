# Core LLM settings
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=90

# OpenAI (used by the cloud deployment). Set LLM_PROVIDER=openai to use it locally.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=xxxxxxxxxx

# Open travel-data providers
OPEN_TRAVEL_DATA_ENABLED=false
WEATHER_PROVIDER_ENABLED=false
PLACES_PROVIDER_ENABLED=false
GROUND_TRANSPORT_ENABLED=false

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# Service URLs
HOST_SERVICE_URL=http://localhost:8000
# Optional. When set, the Host requires it as X-API-Key on POST /run and the UI sends it.
# HOST_API_KEY=
FLIGHT_SERVICE_URL=http://localhost:8001
STAY_SERVICE_URL=http://localhost:8002
ACTIVITIES_SERVICE_URL=http://localhost:8003
DOWNSTREAM_TIMEOUT_SECONDS=30

# Local database / dev convenience
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Optional metrics export to Grafana Cloud (off when the endpoint is unset).
# Copy both values from Grafana Cloud's OpenTelemetry connection page.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 instance-id:token>

# Retrieval (RAG): Wikivoyage guidance added to prompts.
# Build the index first: python -m common.rag.ingest  (Compose: see README)
# The embedding model follows LLM_PROVIDER: OLLAMA_EMBEDDING_MODEL or OPENAI_EMBEDDING_MODEL.
RAG_ENABLED=true
RAG_TOP_K=2
# RAG_INDEX_DIR=data/rag/index
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
